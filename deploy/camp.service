[Unit]
Description=Camp — 会話記録とVaultの保持・検索
Documentation=file:/home/mooma-0750/Documents/git-cloned/camp/README.md
After=network.target

[Service]
Type=simple
User=camp
Group=camp

# 実体は root のもの。**エージェントと同じユーザーからは差し替えられない。**
# リポジトリ内の ./campd を指してはいけない（そこは書き換えられる）。
# -secure-cookie は「Cookie を HTTPS でしか出さない」。
# tailnet へ出すとき（deploy/expose-tailscale.sh）は付ける。
# 127.0.0.1 は安全な文脈として扱われるので、付けてもローカルからは入れる。
ExecStart=/usr/local/bin/campd serve -secure-cookie

# DB は camp のもの。0700 のディレクトリに置く。
Environment=CAMP_DB=/var/lib/camp/camp.sqlite
# **待ち受けは 127.0.0.1 のまま。** 外から使うときも、ここは変えない。
# Tailscale が :443 で終端して、ここへ渡す（deploy/expose-tailscale.sh）。
# 0.0.0.0 にすると LAN からも触れてしまう。
Environment=CAMP_ADDR=127.0.0.1:8785
# 読むだけ。ACL で camp に読み取りを与えてある。
Environment=CAMP_CLAUDE_PROJECTS=/home/mooma-0750/.claude/projects
Environment=CAMP_VAULT=/home/mooma-0750/Documents/git-cloned/Obsidian-Vault
Environment=CAMP_REPORT_GROUP=campreport

# /run/camp を作る。ここに追記専用の報告口が開く。
RuntimeDirectory=camp
RuntimeDirectoryMode=0750
StateDirectory=camp
StateDirectoryMode=0700

# 触る必要のないものは触れなくしておく。
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/camp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
